#!/bin/bash
# Run lumamatch from anywhere: ./lumamatch REFERENCE TARGET [options]
# Uses .venv-mac on macOS, .venv elsewhere (e.g. the Ralph Linux sandbox).

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

if [ "$(uname -s)" = "Darwin" ]; then
  VENV_NAME=".venv-mac"
else
  VENV_NAME=".venv"
fi
PYTHON="$REPO_DIR/$VENV_NAME/bin/python"

if [ ! -x "$PYTHON" ]; then
  echo "lumamatch isn't set up yet (no $VENV_NAME folder in $REPO_DIR)." >&2
  echo "Run these once:" >&2
  echo "  cd \"$REPO_DIR\"" >&2
  echo "  python3 -m venv $VENV_NAME" >&2
  echo "  $VENV_NAME/bin/pip install -r requirements.txt" >&2
  exit 1
fi

PYTHONPATH="$REPO_DIR/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m lumamatch "$@"
